<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>system_manager</name>
  <version>0.0.0</version>
  <description>Navigation manager bridge for optimized paths, TEB tracking and cmd_vel output.</description>
  <maintainer email="juchunyu@qq.com">juchunyu</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>boost</depend>
  <depend>Teb</depend>
  <exec_depend>ego_planner</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
